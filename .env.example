# Copiar este archivo a .env y ajustar los valores reales antes de correr el
# proyecto localmente o en el servidor.

NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/jaym_legal

# JWT (para el módulo de autenticación, próximo módulo a construir)
JWT_SECRET=cambia_esto_por_un_valor_seguro
JWT_EXPIRES_IN=8h

# --- Integración con HubSpot (portal / Hub ID 51539725) --------------------
# 1. En HubSpot: Configuración > Integraciones > Private Apps ("aplicaciones
#    antiguas") > Crear app. Scopes necesarios: crm.objects.contacts.read/write,
#    crm.objects.deals.read/write. Copia el token generado (empieza con
#    "pat-...") aquí abajo.
HUBSPOT_ACCESS_TOKEN=

# 2. En HubSpot: Configuración > Objetos > Negocios > Pipelines — crea (una
#    sola vez) un pipeline llamado exactamente "Casos JAYM LEGAL" con estas 5
#    etapas, en este orden y con estos nombres exactos:
#    Recepción, Solicitud Administrativa, Vía Contenciosa,
#    Cerrado - Favorable (marcada como ganada), Cerrado - Desfavorable
#    (marcada como perdida). El sistema busca el pipeline y las etapas por
#    nombre automáticamente — no hace falta copiar ningún ID.

# --- Integración con Google Calendar -----------------------------------
# Permite que los eventos de la Agenda se reflejen automáticamente en
# Google Calendar (y que los que se creen directamente en Google se
# importen a la Agenda cada 10 minutos). No hay pantalla de "Conectar" en
# este sistema — se obtiene un acceso de larga duración UNA sola vez:
#
# 1. Ir a https://console.cloud.google.com/ y crear un proyecto (o usar
#    uno existente). En el buscador de arriba escribir "Google Calendar
#    API" y presionar "Habilitar".
# 2. Ir a "APIs y servicios" > "Pantalla de consentimiento OAuth" y
#    configurarla en modo "Externo" con tu propio correo (basta con
#    guardar los datos básicos, no hace falta publicarla).
# 3. Ir a "APIs y servicios" > "Credenciales" > "Crear credenciales" >
#    "ID de cliente de OAuth" > tipo de aplicación "Aplicación de
#    escritorio". Copia el "Client ID" y el "Client Secret" generados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# 4. Ir a https://developers.google.com/oauthplayground → ícono de
#    engranaje (arriba a la derecha) → marcar "Use your own OAuth
#    credentials" → pegar el Client ID y Client Secret del paso 3.
# 5. En la lista de la izquierda, buscar "Calendar API v3" y marcar el
#    scope ".../auth/calendar". Presionar "Authorize APIs" e iniciar
#    sesión con la cuenta de Google del despacho.
# 6. Presionar "Exchange authorization code for tokens" y copiar el
#    "Refresh token" que aparece — pegarlo aquí abajo:
GOOGLE_REFRESH_TOKEN=
#
# ID del calendario a usar — "primary" es el calendario principal de la
# cuenta conectada. Solo cambiarlo si se quiere usar otro calendario.
GOOGLE_CALENDAR_ID=primary

# --- Asistente de agenda con Inteligencia Artificial (Claude/Anthropic) --
# 1. Ir a https://console.anthropic.com/ y crear una cuenta (requiere
#    método de pago — el uso del asistente tiene un costo por mensaje).
# 2. Ir a "API Keys" > "Create Key" y copiar la clave generada (empieza
#    con "sk-ant-...") aquí abajo.
ANTHROPIC_API_KEY=
