# Copiar este archivo a .env y ajustar los valores reales antes de correr el
# proyecto localmente o en el servidor.

NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/jaym_legal

# Dominio real donde vive el frontend (sin barra al final). Se usa para dos
# cosas: permitir que ese origen llame al API (CORS) y armar el enlace que
# reciben los usuarios al pedir "olvidé mi contraseña". Admite varios
# orígenes separados por coma (ej. producción + staging). Si se deja
# vacío, cae de vuelta a http://localhost:5173 (desarrollo).
FRONTEND_URL=http://localhost:5173

# Almacenamiento de documentos (sección 12 del requerimiento) -- Cloudflare
# R2, compatible con la API de Amazon S3. Si se dejan estas 4 variables
# vacías/ausentes, el sistema guarda los documentos en el disco local
# (./storage/documentos) -- correcto para desarrollo, pero NO recomendado
# en producción porque Render no garantiza que ese disco persista entre
# despliegues. R2_ACCOUNT_ID es el subdominio que aparece en el endpoint
# que da Cloudflare (https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jaym-legal-documentos

# JWT (para el módulo de autenticación, próximo módulo a construir)
JWT_SECRET=cambia_esto_por_un_valor_seguro
JWT_EXPIRES_IN=8h

# Clave de cifrado para el secreto de 2FA (antes se guardaba en texto plano
# en la base de datos). Cualquier texto largo y aleatorio sirve -- por
# ejemplo, generado con: openssl rand -hex 32
# Obligatoria para poder activar o verificar 2FA; sin ella, el resto del
# sistema sigue funcionando igual (2FA es opcional por usuario).
DOS_FACTOR_CLAVE_CIFRADO=cambia_esto_por_otro_valor_seguro_y_distinto_al_de_arriba

# --- Integración con HubSpot (portal / Hub ID 51539725) --------------------
# 1. En HubSpot: Configuración > Integraciones > Private Apps ("aplicaciones
#    antiguas") > Crear app. Scopes necesarios: crm.objects.contacts.read/write,
#    crm.objects.deals.read/write. Copia el token generado (empieza con
#    "pat-...") aquí abajo.
HUBSPOT_ACCESS_TOKEN=

# 2. En HubSpot: Configuración > Objetos > Negocios > Pipelines — crea (una
#    sola vez) un pipeline llamado exactamente "Casos JAYM LEGAL" con estas 5
#    etapas, en este orden y con estos nombres exactos:
#    Recepción, Solicitud Administrativa, Vía Contenciosa,
#    Cerrado - Favorable (marcada como ganada), Cerrado - Desfavorable
#    (marcada como perdida). El sistema busca el pipeline y las etapas por
#    nombre automáticamente — no hace falta copiar ningún ID.

# --- Integración con Google Calendar -----------------------------------
# Permite que los eventos de la Agenda se reflejen automáticamente en
# Google Calendar (y que los que se creen directamente en Google se
# importen a la Agenda cada 10 minutos). No hay pantalla de "Conectar" en
# este sistema — se obtiene un acceso de larga duración UNA sola vez:
#
# 1. Ir a https://console.cloud.google.com/ y crear un proyecto (o usar
#    uno existente). En el buscador de arriba escribir "Google Calendar
#    API" y presionar "Habilitar".
# 2. Ir a "APIs y servicios" > "Pantalla de consentimiento OAuth" y
#    configurarla en modo "Externo" con tu propio correo (basta con
#    guardar los datos básicos, no hace falta publicarla).
# 3. Ir a "APIs y servicios" > "Credenciales" > "Crear credenciales" >
#    "ID de cliente de OAuth" > tipo de aplicación "Aplicación de
#    escritorio". Copia el "Client ID" y el "Client Secret" generados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# 4. Ir a https://developers.google.com/oauthplayground → ícono de
#    engranaje (arriba a la derecha) → marcar "Use your own OAuth
#    credentials" → pegar el Client ID y Client Secret del paso 3.
# 5. En la lista de la izquierda, buscar "Calendar API v3" y marcar el
#    scope ".../auth/calendar". Presionar "Authorize APIs" e iniciar
#    sesión con la cuenta de Google del despacho.
# 6. Presionar "Exchange authorization code for tokens" y copiar el
#    "Refresh token" que aparece — pegarlo aquí abajo:
GOOGLE_REFRESH_TOKEN=
#
# ID del calendario a usar — "primary" es el calendario principal de la
# cuenta conectada. Solo cambiarlo si se quiere usar otro calendario.
GOOGLE_CALENDAR_ID=primary

# --- Alertas por correo automático (Gmail del despacho) --------------------
# El sistema ya detecta solo (cada hora) expedientes sin movimiento, plazos
# próximos o vencidos, documentos vencidos, requisitos pendientes vencidos,
# eventos de agenda y ahora también facturas vencidas. Con esto configurado,
# además de verse en el panel, las alertas urgentes/críticas llegan por
# correo apenas se detectan, y cada mañana a las 7:00am llega un resumen de
# todo lo que sigue abierto. Si se deja vacío, el sistema sigue funcionando
# exactamente igual, solo que sin avisos por correo.
#
# 1. Crear (o usar) una cuenta de Gmail del despacho — NO la contraseña
#    personal de nadie. Recomendado: una cuenta dedicada, ej.
#    alertas@tudespacho.com o similar.
# 2. Esa cuenta necesita verificación en 2 pasos activada para poder crear
#    una "Contraseña de aplicación". Activarla en:
#    https://myaccount.google.com/security > "Verificación en 2 pasos".
# 3. Ir a https://myaccount.google.com/apppasswords (con esa misma cuenta
#    de Gmail iniciada), escribir un nombre (ej. "JAYM LEGAL") y presionar
#    "Crear". Google muestra una clave de 16 letras — esa es la
#    "contraseña de aplicación": es distinta a la contraseña normal de la
#    cuenta, se puede revocar en cualquier momento sin afectar el correo
#    normal, y es lo único que este sistema necesita.
# 4. Copiar esa clave de 16 letras (sin espacios) directamente aquí abajo,
#    en SMTP_PASS, en tu propio archivo .env — nunca compartirla por chat
#    ni con nadie más.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Nombre que verán los destinatarios como remitente (opcional). Si se deja
# vacío, se usa el mismo SMTP_USER.
SMTP_FROM=JAYM LEGAL <alertas@tudespacho.com>
#
# Correos que reciben los avisos, separados por coma (sin espacios extra
# es opcional, se limpian solos). Ej: socio@tudespacho.com,recepcion@tudespacho.com
ALERTAS_CORREO_DESTINATARIOS=

# --- Asistente de agenda con Inteligencia Artificial (Claude/Anthropic) --
# 1. Ir a https://console.anthropic.com/ y crear una cuenta (requiere
#    método de pago — el uso del asistente tiene un costo por mensaje).
# 2. Ir a "API Keys" > "Create Key" y copiar la clave generada (empieza
#    con "sk-ant-...") aquí abajo.
ANTHROPIC_API_KEY=
