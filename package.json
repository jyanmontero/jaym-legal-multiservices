    "dotenv": "^17.4.2",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "nodemailer": "^9.1.1",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
